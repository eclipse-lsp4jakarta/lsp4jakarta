<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>jakarta-multi-version-sample</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Jakarta Multi-Version Sample</name>
    <description>
        A single-module project mixing Jakarta EE 9, 10, and 11 API dependencies
        to test LSP4Jakarta support for multiple Jakarta versions in one project.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Jakarta EE 9 artifacts -->
        <jakarta.servlet.version>5.0.0</jakarta.servlet.version>       <!-- EE 9 -->
        <jakarta.inject.version>2.0.1</jakarta.inject.version>          <!-- EE 9 -->

        <!-- Jakarta EE 10 artifacts -->
        <jakarta.persistence.version>3.1.0</jakarta.persistence.version> <!-- EE 10 -->
        <jakarta.annotation.version>2.1.1</jakarta.annotation.version>   <!-- EE 10 -->
        <jakarta.ejb.version>4.0.1</jakarta.ejb.version>                 <!-- EE 10 -->

        <!-- Jakarta EE 11 artifacts -->
        <jakarta.validation.version>3.1.0</jakarta.validation.version>  <!-- EE 11 -->
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>            <!-- EE 11 -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>                <!-- EE 11 -->
    </properties>

    <dependencies>

        <!-- ============================================================ -->
        <!-- Jakarta EE 9 Dependencies                                    -->
        <!-- ============================================================ -->

        <!-- Jakarta Servlet 5.0 (EE 9) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Inject 2.0 (EE 9) -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>${jakarta.inject.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================================ -->
        <!-- Jakarta EE 10 Dependencies                                   -->
        <!-- ============================================================ -->

        <!-- Jakarta Persistence 3.1 (EE 10) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Annotation 2.1 (EE 10) -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta EJB 4.0 (EE 10) -->
        <dependency>
            <groupId>jakarta.ejb</groupId>
            <artifactId>jakarta.ejb-api</artifactId>
            <version>${jakarta.ejb.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================================ -->
        <!-- Jakarta EE 11 Dependencies                                   -->
        <!-- ============================================================ -->

        <!-- Jakarta Bean Validation 3.1 (EE 11) -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta.validation.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta REST (JAX-RS) 4.0 (EE 11) -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>${jakarta.ws.rs.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta CDI 4.1 (EE 11) -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
