<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>jakarta-ee9-ee10-sample</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Jakarta EE9 + EE10 Sample</name>
    <description>
        A single-module project mixing Jakarta EE 9 and EE 10 API dependencies
        to test LSP4Jakarta support for multiple Jakarta versions in one project.
    </description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Jakarta EE 9 artifacts -->
        <!-- jakarta.inject-api:2.0.1 excluded — identical version in EE 9, EE 10, and EE 11 -->
        <jakarta.servlet.version>5.0.0</jakarta.servlet.version>         <!-- EE 9: Servlet 5.0       — EE 10=6.0.0,  EE 11=6.1.0 -->
        <jakarta.websocket.version>2.0.0</jakarta.websocket.version>     <!-- EE 9: WebSocket 2.0     — EE 10=2.1.1,  EE 11=2.2.0 -->
        <jakarta.mail.ee9.version>2.0.1</jakarta.mail.ee9.version>       <!-- EE 9: Mail 2.0          — EE 10=2.1.3,  EE 11=2.1.3 -->
        <jakarta.el.ee9.version>4.0.0</jakarta.el.ee9.version>           <!-- EE 9: EL 4.0            — EE 10=5.0.1,  EE 11=6.0.0 -->
        <jakarta.interceptor.ee9.version>2.0.0</jakarta.interceptor.ee9.version> <!-- EE 9: Interceptor 2.0 — EE 10=2.1.0, EE 11=2.2.0 -->

        <!-- Jakarta EE 10 artifacts -->
        <!-- jakarta.ejb-api:4.0.1 excluded — identical version in EE 10 and EE 11 -->
        <jakarta.persistence.version>3.1.0</jakarta.persistence.version> <!-- EE 10: Persistence 3.1  — EE 9=3.0.0,   EE 11=3.2.0 -->
        <jakarta.annotation.version>2.1.1</jakarta.annotation.version>   <!-- EE 10: Annotation 2.1   — EE 9=2.0.0,   EE 11=3.0.0 -->
        <jakarta.validation.version>3.0.2</jakarta.validation.version>   <!-- EE 10: Validation 3.0   — EE 9=3.0.0,   EE 11=3.1.0 -->
        <jakarta.ws.rs.version>3.1.0</jakarta.ws.rs.version>             <!-- EE 10: REST 3.1          — EE 9=3.0.0,   EE 11=4.0.0 -->
        <jakarta.cdi.version>4.0.1</jakarta.cdi.version>                 <!-- EE 10: CDI 4.0           — EE 9=3.0.0,   EE 11=4.1.0 -->
        <jakarta.faces.version>4.0.1</jakarta.faces.version>             <!-- EE 10: Faces 4.0         — EE 9=3.0.0,   EE 11=4.1.0 -->
        <jakarta.el.ee10.version>5.0.1</jakarta.el.ee10.version>         <!-- EE 10: EL 5.0            — EE 9=4.0.0,   EE 11=6.0.0 -->
        <jakarta.interceptor.ee10.version>2.1.0</jakarta.interceptor.ee10.version> <!-- EE 10: Interceptor 2.1 — EE 9=2.0.0, EE 11=2.2.0 -->
        <jakarta.lang.model.version>4.0.1</jakarta.lang.model.version>   <!-- EE 10: Lang Model 4.0    — EE 9=n/a,     EE 11=4.1.0 -->
    </properties>

    <dependencies>

        <!-- ============================================================ -->
        <!-- Jakarta EE 9 Dependencies                                    -->
        <!-- ============================================================ -->

        <!-- Jakarta Servlet 5.0 (EE 9) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Mail 2.0 (EE 9) — replaces jakarta.inject-api:2.0.1 which is version-identical in EE 11 -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
            <version>${jakarta.mail.ee9.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta WebSocket 2.0 (EE 9) -->
        <dependency>
            <groupId>jakarta.websocket</groupId>
            <artifactId>jakarta.websocket-api</artifactId>
            <version>${jakarta.websocket.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta EL 4.0 (EE 9) -->
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>${jakarta.el.ee9.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Interceptor 2.0 (EE 9) -->
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <version>${jakarta.interceptor.ee9.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================================ -->
        <!-- Jakarta EE 10 Dependencies                                   -->
        <!-- ============================================================ -->

        <!-- Jakarta Persistence 3.1 (EE 10) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Annotation 2.1 (EE 10) -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Faces 4.0 (EE 10) — EE 9=3.0.0, EE 11=4.1.0 — version-distinct across all three -->
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
            <version>${jakarta.faces.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Bean Validation 3.0 (EE 10) -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta.validation.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta REST (JAX-RS) 3.1 (EE 10) -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>${jakarta.ws.rs.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta CDI 4.0 (EE 10) -->
        <!-- jakarta.inject-api:2.0.1 excluded — identical version in EE 9, EE 10, and EE 11 -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jakarta EL 5.0 (EE 10) -->
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>${jakarta.el.ee10.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Interceptor 2.1 (EE 10) -->
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <version>${jakarta.interceptor.ee10.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Lang Model 4.0 (EE 10) -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.lang-model</artifactId>
            <version>${jakarta.lang.model.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
